# Live conditions (the conditions-line block). All optional: unset, the app
# uses the hosted Pointmoon, reads only where it has a real place to read, and
# falls back to each block's authored fallbackText on any failure.

# Base URL of the Pointmoon field-truth API (consumed server-side only).
POINTMOON_API_URL=https://pointmoon.ai

# Demo school location, and the only way to MOVE one: there is no implicit
# default in the data layer any more (#1234). Per-school location arrived with
# auth, and a class with its own coordinates ignores these entirely. Left unset
# (as shipped), a surface that can name what it read — the cast, which says
# "the sample patch" — still reads the built-in sample patch, and one that
# cannot, such as the run page's spoken sentence, reads nothing and its
# authored line stands. Set them to run the demo somewhere other than London.
# Blank counts as unset, not as latitude zero.
#   CONDITIONS_LAT=51.546
#   CONDITIONS_LNG=-0.105
CONDITIONS_LAT=
CONDITIONS_LNG=

# Demo fixture mode. Set to a repo-relative JSON file and every Pointmoon read
# is served from that recorded payload instead of the network — for a
# show-and-tell that must not depend on the morning's live data. Every read
# logs the file it served. Leave UNSET everywhere else.
#   POINTMOON_FIXTURE_PATH=tests/fixtures/pointmoon/berkeley_ca.json
POINTMOON_FIXTURE_PATH=

# Required alongside POINTMOON_FIXTURE_PATH when NODE_ENV is production: a
# production deploy has to say out loud that it is running a demo, or the
# fixture flag is refused and the live read happens as normal.
#   DEMO_MODE=1
DEMO_MODE=

# Forward geocoder for onboarding's typed place search (#56), consumed
# server-side only. Unset uses Nominatim (OpenStreetMap) at the URL below:
# free, no account, no key, no spend, ODbL data, and the same geocoder
# Pointmoon already calls. Set this to a self-hosted Nominatim or another
# provider that speaks the same search shape to move off it. See
# lib/outside/geocode.ts for the provider, cost and privacy note.
GEOCODER_API_URL=https://nominatim.openstreetmap.org/search

# ---------------------------------------------------------------------------
# Database (Neon Postgres) — the account layer. The cold-URL demo path
# (/, /run, /print, /api/conditions) needs none of this; packs load from disk.
# Placeholders only here — never commit real connection strings.
# ---------------------------------------------------------------------------

# Pooled connection the app uses at runtime (Neon's -pooler host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (unpooled) connection Prisma Migrate needs (Neon's non-pooler host).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# ---------------------------------------------------------------------------
# Auth (Better Auth). Secret signs sessions; the email key sends magic links.
# With no email key set, the magic link is logged to the server console so
# local sign-in works with no service at all. The demo path needs none of this.
# ---------------------------------------------------------------------------

# Session-signing secret (>= 32 chars). Generate: `openssl rand -base64 32`.
# Better Auth reads BETTER_AUTH_SECRET, and falls back to AUTH_SECRET.
AUTH_SECRET=replace-with-a-long-random-string

# The app's own URL, used to build magic links and pin the passkey origin.
# Locally this is the dev URL; in production set it to the deployed domain.
# Running the signed-in half of the Playwright e2e suite (tests/e2e) needs
# this overridden to http://localhost:3512 instead, matching
# playwright.config.ts's fixed PORT — see tests/README.md.
BETTER_AUTH_URL=http://localhost:3500

# Resend API key for magic-link email. Unset = dev console fallback (the link
# is logged to the server console instead of emailed).
RESEND_API_KEY=

# Where /feedback lands (#644, temporary while we test with real teachers).
# Sent through the same Resend account as sign-in mail. Unset in production
# the form reports "didn't send"; unset in dev the message is logged to the
# server console instead.
FEEDBACK_EMAIL_TO=

# Optional: the from-address for magic-link email (defaults to Resend's
# onboarding sender). Set once you've verified a domain in Resend.
MAGIC_LINK_FROM=


# Sign in with the account the school already gave the teacher. Each provider
# appears on the sign-in page only when BOTH halves of its credential are set,
# so leaving these blank simply means the button is not offered.
#
# Google: an OAuth 2.0 Web application client in Google Cloud console.
# Microsoft: an app registration in Entra ID (Azure), multi-tenant, with a
# client secret. Both need the redirect URI
#   <BETTER_AUTH_URL>/api/auth/callback/<provider>
# e.g. https://natureclass.education/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional teacher AI. Vercel deployments authenticate to AI Gateway with a
# rotating OIDC token automatically. For local or self-hosted use only, set an
# AI Gateway key server-side. Never prefix it NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

AI_GATEWAY_API_KEY=
NATURE_CLASS_AI_MODEL=anthropic/claude-haiku-4.5

# Langfuse -- observability for the AI helpers. Optional, and a silent no-op
# when unset: every helper behaves identically without it, which is the AGPL
# promise (this repo runs with zero external config). Nature Class uses its
# OWN Langfuse project, never a shared one -- separate prompt history, separate
# evals, no coupling to any other product.
#
# Traces deliberately carry NO prompt input and NO model output. A teacher's
# free text can hold a child's question (nc#50, nc#66), so a trace pins prompt
# id + version + model + timing + usage + pass/fail, and nothing else.
#
# Verify with: npm run langfuse:smoke
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ---------------------------------------------------------------------------
# Product analytics (PostHog) -- OFF unless BOTH of these are set, and off is
# how this repository ships. Same promise as Langfuse above: every surface
# behaves identically without it, so a self-hosted Nature Class reports to
# nobody. A hardwired key would make every AGPL deployment send its teachers'
# behaviour to us, which is not a thing a licence like this one should let us
# do by accident.
#
# The host has NO default on purpose: naming the region is a decision #407's
# DPIA has to state out loud, not one this file should make silently.
#
# CURRENT PRODUCTION CHOICE (Johan, 2026-08-29): the existing Rewyld project,
# which is US-region -- so `https://us.i.posthog.com`, and the DPIA records a
# US transfer. Events are stamped product: "nature_class" so they can be told
# apart from the consumer app's in the same table.
#   EU cloud     https://eu.i.posthog.com
#   US cloud     https://us.i.posthog.com
#   self-hosted  your own instance
#
# What it may send is a closed list in lib/analytics/events.ts, held shut by
# scripts/analytics-lint.mjs: teacher-loop events only, an opaque teacher id,
# and never a name, an email, a school, a child, a coordinate, or a word the
# teacher wrote. Cookieless (persistence is memory), no autocapture or
# heatmaps. Session replay is enabled for clicks, taps, scrolls, navigation and
# timing, with every input, text node and string-valued DOM attribute masked;
# console, headers, bodies, canvas and cross-origin frames stay off. See
# lib/analytics/client.ts for the enforced boundary.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Which accounts are ours rather than a teacher's. Comma-separated addresses
# and @domain suffixes; server-side only, and never prefixed NEXT_PUBLIC_ --
# the address is matched here and only the resulting boolean travels, so no
# email goes anywhere near analytics.
#
# The shared PostHog project filters a cohort matching $internal_or_test_user,
# and until this is set that cohort holds nobody: every lesson Johan runs while
# testing counts as a teacher running a lesson. At pilot scale that is most of
# the data, and it already cost the consumer app a retention figure nobody
# could defend.
#
# Unset -- how this repository ships, and how a self-hosting school runs --
# nobody is internal.
#   NATURE_CLASS_INTERNAL_EMAILS=someone@example.com,@rewyld.earth
NATURE_CLASS_INTERNAL_EMAILS=

# Server-to-server bearer credential for the read-only operator API. Never
# expose this as NEXT_PUBLIC_ or send it to browser code. When unset, every
# /api/v1/operator/* route returns 404 and performs no database query.
OPERATOR_SECRET=

# Opt in to the dated USA-NPN teacher section only after Pointmoon #198 runtime deployment.
# Default off. No direct USA-NPN requests originate in Nature Class.
POINTMOON_USANPN_ENABLED=0

# Teacher-selected Boston tide reference; enable only after NOAA Pointmoon host deployment.
POINTMOON_NOAA_ENABLED=0

# Additional lesson references, enable only after Pointmoon source deployment.
POINTMOON_PLACE_EVIDENCE_ENABLED=0

# Optional dedicated Photon endpoint for address autocomplete.
# Defaults to the public Photon service (reasonable-volume use, no SLA).
# AUTOCOMPLETE_API_URL=https://photon.komoot.io/api/
