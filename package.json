{
  "name": "nature-class",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run offline:generate",
    "build": "next build",
    "vercel-build": "node scripts/migrate-if-production.mjs && npm run offline:generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "pretest": "node scripts/worktree-deps-gate.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/worktree-deps-gate.mjs",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/worktree-deps-gate.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "test:e2e": "playwright test",
    "offline:generate": "tsx scripts/build-offline-core.mts",
    "validate:packs": "tsx scripts/validate-packs.mjs",
    "packs:snapshot": "tsx scripts/validate-packs.mjs --write-session-ids",
    "packs:mint-node-ids": "tsx scripts/mint-node-ids.mjs",
    "packs:prove-node-ids": "tsx scripts/node-id-invisibility.mjs",
    "audio:spoken": "node scripts/synthesize-spoken-lines.mjs",
    "preview:narration": "tsx scripts/build-preview-narration.mjs",
    "audio:preview": "node scripts/synthesize-lesson-preview.mjs",
    "validate:prompts": "tsx scripts/validate-prompts.mjs",
    "eval:prompt": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/prompt-eval.mjs",
    "prompts:push": "tsx scripts/langfuse-prompts.mjs push",
    "langfuse:smoke": "node --env-file=.env.local --import tsx scripts/langfuse-smoke.mjs",
    "lint:tokens": "node scripts/token-lint.mjs",
    "lint:analytics": "tsx scripts/analytics-lint.mjs",
    "lint:vercel": "node scripts/vercel-config-lint.mjs",
    "check:guards": "tsx scripts/guard-mutation-check.mjs",
    "patrol:worktrees": "node scripts/worktree-patrol.mjs",
    "sweep:branches": "node scripts/branch-salvage-sweep.mjs",
    "sweep:green": "node scripts/green-pr-sweep.mjs",
    "sweep:unseen": "node scripts/branch-salvage-sweep.mjs --unseen",
    "lint:standards": "node scripts/standards-lint.mjs",
    "lint:action-refresh": "node scripts/action-refresh-lint.mjs",
    "lint:schema-mirror": "tsx scripts/schema-mirror-lint.mjs",
    "lint:migration-order": "node scripts/migration-order-lint.mjs",
    "lint:e2e-reset": "node scripts/e2e-reset-lint.mjs",
    "lint:live-claim": "node scripts/live-claim-lint.mjs",
    "lint:variant-carry": "node scripts/variant-carry-lint.mjs",
    "lint:eval-coverage": "tsx scripts/eval-coverage-lint.mjs",
    "vocab:match": "tsx scripts/vocab-match.mjs",
    "vocab:coverage": "tsx scripts/vocab-match.mjs --coverage",
    "community:export": "node scripts/export-community.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@prisma/client": "6.19.3",
    "@rapideditor/country-coder": "5.6.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.256",
    "better-auth": "1.6.23",
    "next": "^15.5.24",
    "posthog-js": "^1.422.5",
    "posthog-node": "^5.51.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.5.11",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "glob": "^13.0.6",
    "jsdom": "^26.1.0",
    "prisma": "6.19.3",
    "serwist": "^9.5.11",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.2"
  }
